<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <!-- Authentication Flow -->
    <fragment
        android:id="@+id/welcomeFragment"
        android:name="student.projects.musicreviewapp.ui.home.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">

        <action
            android:id="@+id/action_welcomeFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />

        <action
            android:id="@+id/action_welcomeFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="student.projects.musicreviewapp.ui.home.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_sign_in">

        <action
            android:id="@+id/action_signInFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="student.projects.musicreviewapp.ui.home.SignUpFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_sign_up">

        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_signUpFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
    </fragment>

    <!-- Main App Flow -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="student.projects.musicreviewapp.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home_signed_in">

        <!-- ADD THIS ACTION FOR SIGN OUT -->
        <action
            android:id="@+id/action_homeFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="student.projects.musicreviewapp.ui.home.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search_wrapper" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="student.projects.musicreviewapp.ui.home.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/reviewsPageFragment"
        android:name="student.projects.musicreviewapp.ui.home.ReviewsPageFragment"
        android:label="Reviews"
        tools:layout="@layout/fragment_reviews_page" />

</navigation>