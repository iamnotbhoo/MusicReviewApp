<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Your existing ProfileBio component -->
        <student.projects.musicreviewapp.components.profile.ProfileBio
            android:id="@+id/profile_bio_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Favorites Highlights -->
        <student.projects.musicreviewapp.components.profile.ProfileMusicHighlights
            android:id="@+id/favorites_highlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Listened Highlights -->
        <student.projects.musicreviewapp.components.profile.ProfileMusicHighlights
            android:id="@+id/listened_highlights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Reviews -->
        <student.projects.musicreviewapp.components.profile.ProfileReviews
            android:id="@+id/profile_reviews_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>