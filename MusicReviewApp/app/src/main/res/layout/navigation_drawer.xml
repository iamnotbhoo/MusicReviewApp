<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:elevation="16dp">

    <!-- User Info Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#8b7d9e">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not Batman"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRACKD"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:alpha="0.8" />

    </LinearLayout>

    <!-- Menu Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- Popular -->
        <TextView
            android:id="@+id/menu_popular"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Popular"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Playlist (changed from Watchlist) -->
        <TextView
            android:id="@+id/menu_playlist"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Playlist"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Lists -->
        <TextView
            android:id="@+id/menu_lists"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Lists"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Diary -->
        <TextView
            android:id="@+id/menu_diary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Diary"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Reviews -->
        <TextView
            android:id="@+id/menu_reviews"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Reviews"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Activity -->
        <TextView
            android:id="@+id/menu_activity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Activity"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Settings -->
        <TextView
            android:id="@+id/menu_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Settings"
            android:textColor="#000000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Sign Out -->
        <TextView
            android:id="@+id/menu_sign_out"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Sign out"
            android:textColor="#FF0000"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>