<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@color/grey_800"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/extended_music_poster"
        android:layout_width="80dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:background="@color/grey_700"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/extended_music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/music_title"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/extended_timestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/just_now"
            android:textSize="12sp"
            android:textColor="@color/grey_400" />

        <TextView
            android:id="@+id/extended_review_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/extended_review_content_goes_here"
            android:textSize="14sp"
            android:textColor="@color/grey_400"
            android:paddingTop="8dp" />

    </LinearLayout>

</LinearLayout>